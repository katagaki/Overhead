    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overtrain uses your location in the background to keep the Live Activity updated with your current position even when the app is not open."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーバートレインはアプリを開いていないときでもライブアクティビティを最新の位置情報で更新するため、バックグラウンドで位置情報を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overtrain는 앱이 열려 있지 않을 때에도 라이브 활동을 현재 위치로 업데이트하기 위해 백그라운드에서 위치 정보를 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overtrain在后台使用您的位置信息，即使应用未打开也能保持实时活动显示您的当前位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overtrain在背景中使用您的位置資訊，即使應用程式未開啟也能保持即時動態顯示您的目前位置。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overtrain uses your location to track your position along the train line and show it on the Live Activity."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーバートレインは路線上の現在位置を追跡し、ライブアクティビティに表示するために位置情報を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overtrain는 열차 노선을 따라 현재 위치를 추적하고 라이브 활동에 표시하기 위해 위치 정보를 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overtrain使用您的位置信息沿铁路线追踪您的位置并显示在实时活动上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overtrain使用您的位置資訊沿鐵路路線追蹤您的位置並顯示在即時動態上。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overtrain saves images to your photo library so you can keep and share them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーバートレインは画像を写真ライブラリに保存し、保存や共有ができるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overtrain는 이미지를 사진 보관함에 저장하여 보관하고 공유할 수 있도록 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overtrain将图片保存到您的照片图库，以便您保存和分享。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overtrain將圖片儲存到您的照片圖庫，以便您保存和分享。"
          }
        }
      }
    },
    "Overhead Line Package" : {
