{
  "sourceLanguage": "ja",
  "strings": {
    "%@": {
      "comment": "The title and subtitle for a display representation of a BoardPlaceEntity.",
      "isCommentAutoGenerated": true
    },
    "%@ %@ %lld分": {
      "comment": "A label showing the line name, destination, and time left until the next train. The first argument is the line name. The second argument is the destination name. The third argument is the time left in minutes.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ %3$lld分"
          }
        }
      }
    },
    "%@%@": {
      "comment": "A countdown timer with a number and unit. The first argument is the countdown number. The second argument is the countdown unit.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@%2$@"
          }
        }
      }
    },
    "%@発": {
      "comment": "A label displaying the departure time of a train. The argument is the departure time of the train.",
      "isCommentAutoGenerated": true
    },
    "%lld": {
      "comment": "A countdown timer in the systemSmall line board.",
      "isCommentAutoGenerated": true
    },
    "+%lld": {
      "shouldTranslate": false
    },
